rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Independent Care Providers - ID Proof Verification
    match /providers/{providerId}/id_proof/{fileName} {
      allow write: if request.auth != null && request.auth.uid == providerId;
      allow read: if request.auth != null && (
        request.auth.uid == providerId || 
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }
    
    // Marketplace listings photo gallery
    match /listings/{listingId}/photos/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Companion pet records and profile photos
    match /pets/{petId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        petId.matches('^temp-.*') ||
        firestore.get(/databases/(default)/documents/pets/$(petId)).data.ownerId == request.auth.uid
      );
    }

    // Default match for user profiles or other assets
    match /users/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
